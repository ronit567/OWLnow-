{
  "name": "owlnow",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "scraper"
  ],
  "scripts": {
    "dev": "npm run dev -w @owlnow/web",
    "build": "npm run build -w @owlnow/web && npm run build -w @owlnow/extension",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "scrape:courses": "npm run courses -w @owlnow/scraper --",
    "scrape:modules": "npm run modules -w @owlnow/scraper --"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
